/* ==========================================================================
   ASPIRE INDIA — MASTER DESIGN SYSTEM & STYLESHEET
   A Society for the Promotion of Inclusive and Relevant Education
   Official website redesign specification & MVP implementation
   Exact Brand Palette · Authentic Typography · Immersive Visual Hierarchy
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. DESIGN TOKENS (EXACT ASPIRE BRAND PALETTE)
   -------------------------------------------------------------------------- */
:root {
  /* Brand Colours (Extracted from aspire-india.org computed styles) */
  --brand-primary: #ff6d12;         /* ASPIRE Sunset Vibrant Orange */
  --brand-primary-deep: #e30016;    /* Deep Terracotta / Crimson Red */
  --brand-primary-hover: #e55a06;
  --brand-primary-light: #fff2ea;
  --brand-primary-alpha15: rgba(255, 109, 18, 0.15);
  --brand-primary-alpha25: rgba(255, 109, 18, 0.25);

  --brand-navy: #06163a;            /* ASPIRE Deep Heritage Navy */
  --brand-navy-light: #122452;
  --brand-navy-surface: #1e293b;
  --brand-navy-border: #2a3a68;

  --brand-gold: #ff9d00;            /* Warm Sunrise Gold */
  --brand-gold-light: #fff8e8;

  --brand-green: #1b5e20;           /* Deep Growth Green */
  --brand-green-light: #e8f5e9;
  --brand-sage: #c5de8f;            /* ASPIRE Signature Sage Lime */

  /* Neutral Surfaces & Text */
  --text-dark: #1e293b;
  --text-body: #343434;
  --text-secondary: #62718d;
  --text-muted: #88858e;
  --text-white: #ffffff;

  --bg-page: #ffffff;
  --bg-warm: #f7f4f2;               /* ASPIRE Warm Sand Paper */
  --bg-sand: #fefaf6;
  --bg-surface-elevated: #ffffff;

  --border-light: #e8eaee;
  --border-medium: #cbd5e1;
  --border-focus: #ff6d12;

  /* State feedback */
  --color-success: #15803d;
  --color-success-bg: #dcfce7;
  --color-error: #b91c1c;
  --color-error-bg: #fee2e2;

  /* Typography Stack: Outfit (Display & Headings) + Newsreader (Editorial Serifs/Italics) + Plus Jakarta Sans (Comfort Body) */
  --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-serif: 'Newsreader', 'Libre Baskerville', Georgia, serif;
  --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;

  /* Glassmorphism & Soothing Visual Tokens */
  --glass-bg: rgba(255, 255, 255, 0.82);
  --glass-bg-subtle: rgba(247, 244, 242, 0.85);
  --glass-bg-dark: rgba(6, 22, 58, 0.78);
  --glass-border: rgba(255, 255, 255, 0.7);
  --glass-border-subtle: rgba(226, 232, 240, 0.8);
  --glass-border-dark: rgba(255, 255, 255, 0.16);
  --glass-blur: blur(20px);
  --glass-shadow: 0 16px 40px rgba(6, 22, 58, 0.07);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-xl: 24px;
  --radius-2xl: 28px;
  --radius-3xl: 36px;
  --radius-full: 9999px;

  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  --space-20: 5rem;
  --space-24: 6rem;

  --container-max-width: 1260px;
  --header-height: 84px;

  --radius-sm: 6px;
  --radius-md: 10px;
  --radius-lg: 16px;
  --radius-xl: 22px;
  --radius-full: 9999px;

  --shadow-sm: 0 2px 4px rgba(6, 22, 58, 0.04);
  --shadow-md: 0 6px 16px rgba(6, 22, 58, 0.08);
  --shadow-lg: 0 12px 28px rgba(6, 22, 58, 0.12);
  --shadow-xl: 0 20px 40px rgba(6, 22, 58, 0.16);
  --shadow-glow: 0 0 24px rgba(255, 109, 18, 0.35);

  --transition-fast: 180ms ease;
  --transition-normal: 280ms ease;
}

/* --------------------------------------------------------------------------
   2. RESET & GLOBAL DEFAULTS
   -------------------------------------------------------------------------- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  font-family: var(--font-body);
  font-size: 16px;
  color: var(--text-dark);
  background-color: var(--bg-page);
  scroll-behavior: smooth;
  -webkit-font-smoothing: antialiased;
}

body {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  color: var(--text-body);
}

body.no-scroll {
  overflow: hidden;
}

img, svg, picture {
  display: block;
  max-width: 100%;
}

a {
  color: inherit;
  text-decoration: none;
  transition: all var(--transition-fast);
}

button, input, select, textarea {
  font: inherit;
  color: inherit;
}

/* Accessible Skip Link */
.skip-to-content {
  position: absolute;
  top: -100px;
  left: 1rem;
  background: var(--brand-primary);
  color: #fff;
  padding: 0.75rem 1.5rem;
  z-index: 99999;
  border-radius: var(--radius-md);
  font-weight: 600;
  box-shadow: var(--shadow-xl);
  transition: top var(--transition-normal);
}
.skip-to-content:focus {
  top: 1rem;
}

:focus-visible {
  outline: 3px solid var(--brand-primary);
  outline-offset: 3px;
}

/* --------------------------------------------------------------------------
   3. TYPOGRAPHY
   -------------------------------------------------------------------------- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-heading);
  font-weight: 700;
  line-height: 1.22;
  color: var(--brand-navy);
  letter-spacing: -0.02em;
}

h1 { font-size: clamp(2.25rem, 4.5vw + 1rem, 4rem); font-weight: 800; }
h2 { font-size: clamp(1.75rem, 3vw + 0.5rem, 2.75rem); }
h3 { font-size: clamp(1.35rem, 2vw + 0.5rem, 1.85rem); }
h4 { font-size: 1.25rem; }

.font-serif {
  font-family: var(--font-serif);
}

p {
  line-height: 1.7;
  color: var(--text-body);
}

/* --------------------------------------------------------------------------
   4. LAYOUT CONTAINERS & SECTIONS
   -------------------------------------------------------------------------- */
.container {
  width: 100%;
  max-width: var(--container-max-width);
  margin-left: auto;
  margin-right: auto;
  padding-left: var(--space-6);
  padding-right: var(--space-6);
}

.container-narrow {
  max-width: 860px;
  margin-left: auto;
  margin-right: auto;
}

section {
  padding-top: var(--space-20);
  padding-bottom: var(--space-20);
  position: relative;
  scroll-margin-top: calc(var(--header-height) + 16px);
}

.section-header {
  text-align: center;
  max-width: 820px;
  margin: 0 auto var(--space-12);
}

.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--brand-primary);
  background: var(--brand-primary-light);
  padding: 0.35rem 1rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-3);
  border: 1px solid rgba(255, 109, 18, 0.2);
}

.section-title {
  margin-bottom: var(--space-4);
}

.section-subtitle {
  font-size: 1.125rem;
  color: var(--text-secondary);
  line-height: 1.65;
}

/* --------------------------------------------------------------------------
   5. BUTTONS & ACTIONS
   -------------------------------------------------------------------------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  padding: 0.9rem 1.85rem;
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 1rem;
  line-height: 1;
  text-align: center;
  white-space: nowrap;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand-primary) 0%, var(--brand-primary-deep) 100%);
  color: #ffffff;
  box-shadow: 0 4px 14px rgba(255, 109, 18, 0.4);
  border: none;
}
.btn-primary:hover {
  background: linear-gradient(135deg, var(--brand-primary-hover) 0%, #c40013 100%);
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(255, 109, 18, 0.5);
  color: #fff;
}

.btn-secondary {
  background-color: var(--brand-navy);
  color: #ffffff;
  border: none;
}
.btn-secondary:hover {
  background-color: var(--brand-navy-light);
  transform: translateY(-2px);
  color: #fff;
}

.btn-outline-white {
  background: rgba(255, 255, 255, 0.15);
  color: #ffffff;
  border: 2px solid rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(8px);
}
.btn-outline-white:hover {
  background: #ffffff;
  color: var(--brand-navy);
  border-color: #ffffff;
  transform: translateY(-2px);
}

.btn-outline {
  background: transparent;
  color: var(--brand-primary);
  border: 2px solid var(--brand-primary);
}
.btn-outline:hover {
  background-color: var(--brand-primary);
  color: #ffffff;
}

.btn-sm {
  padding: 0.55rem 1.25rem;
  font-size: 0.875rem;
}

.btn-lg {
  padding: 1.15rem 2.4rem;
  font-size: 1.125rem;
}

.btn-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  align-items: center;
}

/* --------------------------------------------------------------------------
   6. SITE HEADER & NAVIGATION
   -------------------------------------------------------------------------- */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--header-height);
  background-color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border-light);
  z-index: 1000;
  transition: all var(--transition-normal);
}

.site-header.scrolled {
  background-color: #ffffff;
  box-shadow: var(--shadow-md);
  height: 76px;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.site-logo {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  text-decoration: none;
}

.site-logo img {
  height: 48px;
  width: auto;
  object-fit: contain;
  transition: height var(--transition-fast);
}

.site-header.scrolled .site-logo img {
  height: 42px;
}

.desktop-nav {
  display: none;
}

@media (min-width: 1024px) {
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
}

.nav-list {
  display: flex;
  align-items: center;
  gap: var(--space-2);
}

.nav-item {
  position: relative;
}

.nav-link {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0.6rem 0.95rem;
  font-size: 0.925rem;
  font-weight: 500;
  color: var(--brand-navy);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.nav-link:hover, .nav-link.is-active {
  color: var(--brand-primary);
  background-color: var(--brand-primary-light);
}

.nav-dropdown-toggle {
  background: none;
  cursor: pointer;
  border: none;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.nav-dropdown-toggle svg {
  transition: transform var(--transition-fast);
}

.nav-dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 290px;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: var(--radius-2xl);
  box-shadow: 0 20px 45px rgba(6, 22, 58, 0.16);
  border: 1px solid rgba(255, 255, 255, 0.9);
  padding: var(--space-3);
  margin-top: var(--space-2);
  opacity: 0;
  visibility: hidden;
  transform: translateY(12px);
  transition: all var(--transition-fast);
  z-index: 1000;
  pointer-events: none;
}

/* Invisible bridge so mouse does not leave dropdown when moving between trigger and menu */
.nav-dropdown-menu::before {
  content: '';
  position: absolute;
  top: -14px;
  left: 0;
  right: 0;
  height: 14px;
}

/* Desktop hover, focus-within, and active class states */
@media (min-width: 992px) {
  .nav-item:hover > .nav-dropdown-menu,
  .nav-item:focus-within > .nav-dropdown-menu,
  .nav-dropdown-menu.is-open {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
    pointer-events: auto !important;
  }

  .nav-item:hover > .nav-dropdown-toggle svg,
  .nav-item:focus-within > .nav-dropdown-toggle svg,
  .nav-dropdown-toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
}

.nav-dropdown-menu.is-open {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
  pointer-events: auto;
}

.dropdown-link {
  display: block;
  padding: 0.75rem 1rem;
  border-radius: var(--radius-md);
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--brand-navy);
  transition: all var(--transition-fast);
}

.dropdown-link:hover, .dropdown-link.is-active {
  background-color: var(--brand-primary-light);
  color: var(--brand-primary);
  transform: translateX(4px);
}

.dropdown-desc {
  font-size: 0.775rem;
  color: var(--text-secondary);
  display: block;
  font-weight: 400;
  margin-top: 2px;
}

/* Mobile Hamburger & Drawer */
.hamburger-btn {
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  width: 34px;
  height: 34px;
  background: transparent;
  padding: 4px;
  cursor: pointer;
  z-index: 1001;
}

@media (min-width: 1024px) {
  .hamburger-btn {
    display: none;
  }
}

.hamburger-line {
  width: 100%;
  height: 2.5px;
  background-color: var(--brand-navy);
  border-radius: 2px;
  transition: all var(--transition-fast);
}

.drawer-overlay {
  position: fixed;
  inset: 0;
  background-color: rgba(6, 22, 58, 0.65);
  backdrop-filter: blur(4px);
  z-index: 1050;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.drawer-overlay.is-visible {
  opacity: 1;
  visibility: visible;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  width: 86%;
  max-width: 400px;
  background-color: #ffffff;
  box-shadow: var(--shadow-xl);
  z-index: 1060;
  padding: var(--space-6);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  transform: translateX(100%);
  transition: transform var(--transition-normal);
}

.mobile-drawer.is-open {
  transform: translateX(0);
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: var(--space-4);
  border-bottom: 1px solid var(--border-light);
  margin-bottom: var(--space-4);
}

.drawer-close-btn {
  font-size: 1.75rem;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-md);
  color: var(--brand-navy);
  cursor: pointer;
}

.mobile-nav-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}

.mobile-nav-link {
  display: block;
  padding: 0.8rem 1rem;
  font-weight: 600;
  font-size: 1.05rem;
  color: var(--brand-navy);
  border-radius: var(--radius-md);
}

.mobile-nav-link:hover, .mobile-nav-link.is-active {
  background-color: var(--brand-primary-light);
  color: var(--brand-primary);
}

.accordion-menu {
  display: none;
  padding-left: var(--space-4);
  margin-top: var(--space-1);
  border-left: 2px solid var(--brand-primary);
}

.accordion-menu.is-open {
  display: block;
}

/* --------------------------------------------------------------------------
   7. DYNAMIC SPLIT HERO WITH EMBEDDED SLIDESHOW & FULL CONTAINER WIDTH
   -------------------------------------------------------------------------- */
.hero-immersive {
  position: relative;
  min-height: 86vh;
  display: flex;
  align-items: center;
  background: radial-gradient(circle at 75% 20%, rgba(255, 109, 18, 0.08) 0%, transparent 45%),
              linear-gradient(135deg, #071530 0%, #0a1e45 60%, #0c2555 100%);
  color: #ffffff;
  padding-top: calc(var(--header-height) + var(--space-8));
  padding-bottom: var(--space-12);
  overflow: hidden;
}

.hero-overlay {
  display: none;
}

.hero-split-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  align-items: center;
  position: relative;
  z-index: 2;
}

@media (min-width: 1024px) {
  .hero-split-grid {
    grid-template-columns: 1.15fr 0.95fr;
    gap: var(--space-12);
  }
}

.hero-content-wrap {
  position: relative;
  z-index: 2;
}

.hero-pill-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  background: rgba(255, 109, 18, 0.15);
  border: 1px solid rgba(255, 109, 18, 0.5);
  color: #ffffff;
  padding: 0.45rem 1.25rem;
  border-radius: var(--radius-full);
  font-size: 0.825rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-6);
  backdrop-filter: blur(12px);
}

.hero-pill-badge span.pulse-dot {
  width: 8px;
  height: 8px;
  background: #ff6d12;
  border-radius: 50%;
  box-shadow: 0 0 10px #ff6d12;
  animation: pulse 1.8s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.8; }
}

.hero-title-main {
  color: #ffffff;
  font-family: var(--font-serif);
  font-size: clamp(2.3rem, 4.4vw + 0.8rem, 3.9rem);
  line-height: 1.18;
  margin-bottom: var(--space-5);
  font-weight: 700;
  letter-spacing: -0.02em;
}

.hero-title-main span.highlight {
  color: var(--brand-gold);
  font-style: italic;
  font-weight: 700;
}

.hero-lead-narrative {
  font-size: clamp(1.05rem, 1.3vw + 0.4rem, 1.25rem);
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.92);
  margin-bottom: var(--space-8);
  max-width: 640px;
}

.hero-lead-narrative strong {
  color: #ffffff;
  font-weight: 700;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  align-items: center;
  margin-bottom: var(--space-10);
}

/* Interactive Story Slide Showcase with Glassmorphism */
.hero-slideshow-card {
  position: relative;
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: var(--radius-3xl);
  padding: var(--space-4);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.45);
}

.hero-slide-viewport {
  position: relative;
  width: 100%;
  height: 380px;
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.hero-slide-item {
  position: absolute;
  inset: 0;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.8s ease, transform 0.8s ease;
  transform: scale(1.04);
}

.hero-slide-item.is-active {
  opacity: 1;
  visibility: visible;
  transform: scale(1);
}

.hero-slide-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-slide-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--space-6) var(--space-6) var(--space-4);
  background: linear-gradient(to top, rgba(6, 22, 58, 0.95) 0%, rgba(6, 22, 58, 0.7) 60%, transparent 100%);
  color: #ffffff;
}

.hero-slide-caption .slide-tag {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--brand-primary);
  margin-bottom: 4px;
  display: block;
}

.hero-slide-caption .slide-text {
  font-size: 0.925rem;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.95);
  margin-bottom: 0;
}

.hero-slide-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-3) var(--space-2) 0;
}

.hero-slide-dots {
  display: flex;
  gap: 8px;
}

.hero-dot-btn {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
  padding: 0;
}

.hero-dot-btn.is-active {
  width: 28px;
  border-radius: var(--radius-full);
  background: var(--brand-primary);
}

.hero-slide-nav-btns {
  display: flex;
  gap: 8px;
}

.hero-nav-arrow {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.hero-nav-arrow:hover {
  background: var(--brand-primary);
  border-color: var(--brand-primary);
}

/* Stat Ribbon on Hero */
.hero-stat-ribbon {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
  margin-top: var(--space-8);
  padding-top: var(--space-6);
  border-top: 1px solid rgba(255, 255, 255, 0.18);
}

@media (min-width: 640px) {
  .hero-stat-ribbon {
    grid-template-columns: repeat(4, 1fr);
  }
}

.hero-ribbon-item .ribbon-num {
  font-size: 1.85rem;
  font-weight: 800;
  color: var(--brand-gold);
  line-height: 1;
  margin-bottom: 4px;
}

.hero-ribbon-item .ribbon-label {
  font-size: 0.8rem;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.35;
}

/* --------------------------------------------------------------------------
   7B. DONATE BUTTON SMILING CHILD MICRO-INTERACTION (PROFESSIONAL & HEARTWARMING)
   -------------------------------------------------------------------------- */
.donate-cta-wrap {
  position: relative;
  display: inline-block;
}

.donate-hover-badge {
  position: absolute;
  bottom: calc(100% + 12px);
  left: 50%;
  transform: translateX(-50%) translateY(8px);
  opacity: 0;
  pointer-events: none;
  background: #ffffff;
  color: var(--brand-navy);
  padding: 6px 14px 6px 8px;
  border-radius: var(--radius-full);
  box-shadow: 0 12px 30px rgba(6, 22, 58, 0.28);
  display: flex;
  align-items: center;
  gap: 10px;
  white-space: nowrap;
  font-size: 0.8rem;
  font-weight: 600;
  transition: all 0.28s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 100;
  border: 1px solid rgba(255, 109, 18, 0.3);
}

.donate-hover-badge::after {
  content: '';
  position: absolute;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  border: 6px solid transparent;
  border-top-color: #ffffff;
}

.donate-hover-badge img.child-avatar {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid var(--brand-primary);
}

.donate-cta:hover .donate-hover-badge,
.donate-cta-wrap:hover .donate-hover-badge {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

/* --------------------------------------------------------------------------
   8. CORE USP: WHY ASPIRE IS DIFFERENT (SYSTEMIC VS ISOLATED)
   -------------------------------------------------------------------------- */
.usp-section {
  background: #ffffff;
  padding: var(--space-20) 0;
  border-bottom: 1px solid var(--border-light);
}

.usp-comparison-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
  margin-top: var(--space-12);
}

@media (min-width: 900px) {
  .usp-comparison-grid {
    grid-template-columns: 1fr 1.25fr;
    gap: var(--space-8);
  }
}

.usp-card-isolated {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(203, 213, 225, 0.6);
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  box-shadow: 0 10px 25px rgba(6, 22, 58, 0.03);
}

.usp-card-isolated .usp-tag {
  color: var(--text-muted);
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: var(--space-3);
  display: flex;
  align-items: center;
  gap: 6px;
}

.usp-card-isolated h3 {
  font-size: 1.35rem;
  color: var(--brand-navy);
  margin-bottom: var(--space-3);
}

.usp-card-isolated p {
  font-size: 0.925rem;
  line-height: 1.65;
  color: var(--text-secondary);
}

.usp-card-systemic {
  background: linear-gradient(135deg, rgba(6, 22, 58, 0.92) 0%, rgba(13, 37, 85, 0.95) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  color: #ffffff;
  border: 1px solid rgba(255, 109, 18, 0.4);
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  box-shadow: 0 20px 45px rgba(6, 22, 58, 0.16);
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.usp-card-systemic::before {
  content: '';
  position: absolute;
  top: -40px;
  right: -40px;
  width: 140px;
  height: 140px;
  background: radial-gradient(circle, rgba(255, 109, 18, 0.25) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.usp-card-systemic .usp-tag {
  color: var(--brand-gold);
  font-size: 0.8rem;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: var(--space-3);
  display: flex;
  align-items: center;
  gap: 6px;
}

.usp-card-systemic h3 {
  font-size: 1.5rem;
  color: #ffffff;
  font-family: var(--font-serif);
  margin-bottom: var(--space-3);
}

.usp-card-systemic p {
  font-size: 0.975rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.92);
}

/* --------------------------------------------------------------------------
   8B. CORE BELIEFS & MISSION/VISION WITH SOOTHING GLASSMORPHISM
   -------------------------------------------------------------------------- */
.beliefs-section {
  background: var(--bg-warm);
  padding: var(--space-20) 0;
  border-bottom: 1px solid var(--border-light);
}

.mv-glass-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  margin-bottom: var(--space-12);
}

@media (min-width: 768px) {
  .mv-glass-grid {
    grid-template-columns: 1fr 1fr;
  }
}

.mv-glass-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  box-shadow: 0 10px 30px rgba(6, 22, 58, 0.04);
  transition: all var(--transition-normal);
}

.mv-glass-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: var(--brand-primary);
}

.mv-glass-icon {
  font-size: 2.25rem;
  margin-bottom: var(--space-3);
}

.mv-glass-card h3 {
  font-size: 1.45rem;
  color: var(--brand-navy);
  margin-bottom: var(--space-2);
}

.mv-glass-card p {
  font-size: 0.95rem;
  line-height: 1.68;
  color: var(--text-secondary);
}

.beliefs-grid-elevated {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
}

@media (min-width: 640px) {
  .beliefs-grid-elevated {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .beliefs-grid-elevated {
    grid-template-columns: repeat(4, 1fr);
  }
}

.belief-glass-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border: 1px solid rgba(226, 232, 240, 0.8);
  border-radius: var(--radius-2xl);
  padding: var(--space-7);
  box-shadow: 0 6px 20px rgba(6, 22, 58, 0.03);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.belief-glass-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: var(--brand-primary);
  background: #ffffff;
}

.belief-glass-card .belief-icon {
  font-size: 2rem;
  margin-bottom: var(--space-3);
}

.belief-glass-card h4 {
  font-size: 1.15rem;
  color: var(--brand-navy);
  margin-bottom: var(--space-2);
}

.belief-glass-card p {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--text-secondary);
}

/* --------------------------------------------------------------------------
   9. THE 3 DEFINED PILLARS WITH CRISP CARDS & SUBPAGE PATHWAYS
   -------------------------------------------------------------------------- */
.three-pillars-section {
  background-color: var(--bg-warm);
  padding: var(--space-20) 0;
}

.pillar-grid-elevated {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
  margin-top: var(--space-12);
}

@media (min-width: 900px) {
  .pillar-grid-elevated {
    grid-template-columns: repeat(3, 1fr);
  }
}

.pillar-card-elevated {
  background: #ffffff;
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
  position: relative;
}

.pillar-card-elevated:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-xl);
  border-color: var(--brand-primary);
}

.pillar-number {
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: var(--space-4);
  display: inline-block;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
}

.pillar-card-elevated:nth-child(1) .pillar-number {
  background: #E0F2FE;
  color: #0369A1;
}

.pillar-card-elevated:nth-child(2) .pillar-number {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.pillar-card-elevated:nth-child(3) .pillar-number {
  background: #DCFCE7;
  color: #15803D;
}

.pillar-icon-box {
  width: 58px;
  height: 58px;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
  margin-bottom: var(--space-5);
  background: var(--bg-warm);
}

.pillar-card-elevated h3 {
  font-size: 1.35rem;
  margin-bottom: var(--space-3);
  color: var(--brand-navy);
}

.pillar-card-elevated p {
  font-size: 0.925rem;
  line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
  flex-grow: 1;
}

.pillar-proof-strip {
  padding: var(--space-3) var(--space-4);
  background: var(--bg-warm);
  border-radius: var(--radius-md);
  font-size: 0.8rem;
  font-weight: 600;
  color: var(--brand-navy);
  margin-bottom: var(--space-5);
}

.pillar-learn-more {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--brand-primary);
  text-decoration: none;
  transition: transform var(--transition-fast);
}

.pillar-card-elevated:hover .pillar-learn-more {
  transform: translateX(4px);
}


/* --------------------------------------------------------------------------
   8. START WITH THE STORY: EDITORIAL HUMAN NARRATIVE SECTION
   -------------------------------------------------------------------------- */
.story-start-section {
  background-color: var(--bg-sand);
  border-bottom: 1px solid var(--border-light);
}

.story-start-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-12);
  align-items: center;
}

@media (min-width: 1024px) {
  .story-start-grid {
    grid-template-columns: 1.15fr 0.85fr;
  }
}

.story-lead-quote {
  font-family: var(--font-serif);
  font-size: 1.65rem;
  font-style: italic;
  color: var(--brand-primary);
  line-height: 1.5;
  border-left: 4px solid var(--brand-primary);
  padding-left: var(--space-6);
  margin-bottom: var(--space-6);
}

.story-frame-card {
  position: relative;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  border: 4px solid #ffffff;
}

.story-frame-card img {
  width: 100%;
  height: 440px;
  object-fit: cover;
  transition: transform var(--transition-normal);
}

.story-frame-card:hover img {
  transform: scale(1.03);
}

.story-frame-badge {
  position: absolute;
  bottom: var(--space-4);
  left: var(--space-4);
  right: var(--space-4);
  background: rgba(6, 22, 58, 0.9);
  color: #fff;
  padding: var(--space-4);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(8px);
}

/* --------------------------------------------------------------------------
   9. MISSION & THREE PILLARS (ACCESS, LEARNING, GOVERNANCE)
   -------------------------------------------------------------------------- */
.pillars-section {
  background-color: #ffffff;
}

.pillars-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}

@media (min-width: 768px) {
  .pillars-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.pillar-card {
  background: var(--bg-warm);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  border: 1px solid var(--border-light);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
  position: relative;
  overflow: hidden;
}

.pillar-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--shadow-xl);
  border-color: var(--brand-primary);
  background: #ffffff;
}

.pillar-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6px;
  background: var(--brand-primary);
}

.pillar-card-access::before { background: #0284c7; }
.pillar-card-learning::before { background: var(--brand-primary); }
.pillar-card-governance::before { background: var(--brand-green); }

.pillar-badge {
  display: inline-block;
  align-self: flex-start;
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 0.3rem 0.8rem;
  border-radius: var(--radius-full);
  margin-bottom: var(--space-4);
}

.pillar-card-access .pillar-badge { background: #e0f2fe; color: #0284c7; }
.pillar-card-learning .pillar-badge { background: var(--brand-primary-light); color: var(--brand-primary); }
.pillar-card-governance .pillar-badge { background: var(--brand-green-light); color: var(--brand-green); }

.pillar-title {
  font-size: 1.5rem;
  margin-bottom: var(--space-2);
}

.pillar-headline {
  font-size: 1rem;
  font-weight: 600;
  color: var(--brand-navy);
  margin-bottom: var(--space-3);
  line-height: 1.4;
}

.pillar-desc {
  font-size: 0.925rem;
  line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
  flex-grow: 1;
}

.pillar-link {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  font-weight: 700;
  font-size: 0.9rem;
  color: var(--brand-primary);
}

/* --------------------------------------------------------------------------
   10. IMPACT COUNTERS (DARK NAVY WITH GOLD METRICS)
   -------------------------------------------------------------------------- */
.impact-section {
  background: linear-gradient(135deg, var(--brand-navy) 0%, #101d42 100%);
  color: #ffffff;
}

.impact-section .section-title {
  color: #ffffff;
}

.impact-section .section-subtitle {
  color: #cbd5e1;
}

.impact-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
  margin-bottom: var(--space-8);
}

@media (min-width: 1024px) {
  .impact-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
}

.impact-card {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: var(--radius-xl);
  padding: var(--space-8);
  text-align: center;
  backdrop-filter: blur(6px);
  transition: all var(--transition-normal);
}

.impact-card:hover {
  background: rgba(255, 255, 255, 0.1);
  transform: translateY(-4px);
  border-color: var(--brand-primary);
}

.impact-number {
  font-size: clamp(2.4rem, 4vw + 1rem, 3.75rem);
  font-weight: 800;
  color: var(--brand-gold);
  line-height: 1;
  margin-bottom: var(--space-2);
}

.impact-label {
  font-size: 1.1rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: var(--space-1);
}

.impact-context {
  font-size: 0.85rem;
  color: #94a3b8;
}

/* --------------------------------------------------------------------------
   11. REAL PARTNERS LOGO SHOWCASE
   -------------------------------------------------------------------------- */
.partners-section {
  background-color: #ffffff;
}

.partners-logo-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
  align-items: center;
}

@media (min-width: 640px) {
  .partners-logo-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1024px) {
  .partners-logo-grid {
    grid-template-columns: repeat(5, 1fr);
  }
}

.partner-logo-item {
  background: var(--bg-warm);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: var(--space-6);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 110px;
  transition: all var(--transition-fast);
}

.partner-logo-item img {
  max-height: 52px;
  width: auto;
  object-fit: contain;
  filter: grayscale(20%);
  transition: all var(--transition-fast);
}

.partner-logo-item:hover {
  background: #ffffff;
  border-color: var(--brand-primary);
  transform: translateY(-3px);
  box-shadow: var(--shadow-md);
}

.partner-logo-item:hover img {
  filter: none;
  transform: scale(1.05);
}

/* --------------------------------------------------------------------------
   12. ELEVATED DONATION EXPERIENCE WITH TANGIBLE HUMAN IMPACT & 80G
   -------------------------------------------------------------------------- */
.donation-hero-box {
  background: linear-gradient(135deg, var(--brand-navy) 0%, #162a5b 100%);
  color: #ffffff;
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  margin-bottom: var(--space-12);
  position: relative;
  overflow: hidden;
  box-shadow: var(--shadow-xl);
}

.donation-hero-box::before {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 50%;
  background: radial-gradient(circle at 80% 20%, rgba(255, 109, 18, 0.25) 0%, transparent 60%);
  pointer-events: none;
}

.donate-tier-card {
  border: 2px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  background: #ffffff;
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: left;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.donate-tier-card:hover {
  border-color: var(--brand-primary);
  background: var(--brand-primary-light);
}

.donate-tier-card.is-selected {
  border-color: var(--brand-primary);
  background: #fff;
  box-shadow: 0 0 0 2px var(--brand-primary), var(--shadow-md);
}

.donate-tier-amount {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--brand-navy);
}

.donate-tier-impact {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.4;
}

.tax-badge-80g {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: var(--brand-green-light);
  color: var(--brand-green);
  font-weight: 700;
  font-size: 0.8rem;
  padding: 0.3rem 0.75rem;
  border-radius: var(--radius-full);
}

/* --------------------------------------------------------------------------
   12B. INSTANT DONATION MOTIVATION SYSTEM & SCHOOL-GOING VISUALIZER
   -------------------------------------------------------------------------- */
.school-going-visualizer {
  background: linear-gradient(135deg, #06163a 0%, #0d2861 100%);
  color: #ffffff;
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  margin-bottom: var(--space-8);
  box-shadow: 0 16px 36px rgba(6, 22, 58, 0.25);
  border: 1px solid rgba(255, 109, 18, 0.3);
  position: relative;
  overflow: hidden;
}

.school-going-visualizer::after {
  content: '';
  position: absolute;
  top: -60px;
  right: -60px;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle, rgba(255, 157, 0, 0.2) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.visualizer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-4);
  margin-bottom: var(--space-6);
}

.visualizer-title {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--brand-gold);
  display: flex;
  align-items: center;
  gap: 8px;
}

.visualizer-output-hero {
  display: flex;
  align-items: baseline;
  gap: 12px;
  margin-bottom: var(--space-4);
}

.visualizer-output-hero .count-number {
  font-size: 3.5rem;
  font-weight: 800;
  color: #ffffff;
  line-height: 1;
  font-family: var(--font-serif);
  text-shadow: 0 2px 12px rgba(255, 109, 18, 0.4);
}

.visualizer-output-hero .count-label {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--brand-gold);
}

.school-going-avatars {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
  padding: var(--space-4) 0;
  min-height: 60px;
}

.school-child-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.12);
  border: 1px solid rgba(255, 255, 255, 0.25);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  color: #ffffff;
  animation: childPopIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

@keyframes childPopIn {
  from { opacity: 0; transform: scale(0.6) translateY(10px); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

.school-child-pill.bonus-pill {
  background: var(--brand-primary);
  border-color: var(--brand-gold);
}

.school-progress-bar-wrap {
  width: 100%;
  height: 8px;
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-full);
  overflow: hidden;
  margin-top: var(--space-3);
  margin-bottom: var(--space-6);
}

.school-progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--brand-primary) 0%, var(--brand-gold) 100%);
  border-radius: var(--radius-full);
  transition: width 0.5s ease;
}

.visualizer-metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
  padding-top: var(--space-5);
  border-top: 1px solid rgba(255, 255, 255, 0.15);
}

@media (max-width: 600px) {
  .visualizer-metrics-grid {
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
}

.v-metric-item .v-num {
  font-size: 1.35rem;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 2px;
}

.v-metric-item .v-desc {
  font-size: 0.775rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.35;
}

/* 1-Click Share Motivation */
.share-impact-box {
  background: var(--bg-warm);
  border: 1px solid var(--border-light);
  border-radius: var(--radius-xl);
  padding: var(--space-6);
  margin-top: var(--space-8);
  text-align: center;
}

.share-btns-wrap {
  display: flex;
  justify-content: center;
  gap: var(--space-3);
  margin-top: var(--space-4);
  flex-wrap: wrap;
}

.btn-share {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  text-decoration: none;
  transition: all var(--transition-fast);
  color: #ffffff;
}

.btn-share-whatsapp {
  background: #25D366;
}

.btn-share-linkedin {
  background: #0A66C2;
}

.btn-share-twitter {
  background: #1DA1F2;
}

.btn-share:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-md);
  color: #ffffff;
}

/* --------------------------------------------------------------------------
   12C. DIRECTORY TABS & FILTERING FOR TEAM AND BOARD PAGES
   -------------------------------------------------------------------------- */
.directory-tabs {
  display: flex;
  gap: var(--space-3);
  margin-bottom: var(--space-10);
  border-bottom: 2px solid var(--border-light);
  padding-bottom: var(--space-4);
  flex-wrap: wrap;
}

.dir-tab-btn {
  background: transparent;
  border: none;
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-secondary);
  padding: 8px 18px;
  border-radius: var(--radius-full);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.dir-tab-btn.is-active, .dir-tab-btn:hover {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
}

.dir-tab-btn.is-active {
  font-weight: 700;
  box-shadow: 0 2px 8px rgba(255, 109, 18, 0.2);
}


/* --------------------------------------------------------------------------
   13. FOOTER
   -------------------------------------------------------------------------- */
.site-footer {
  background-color: var(--brand-navy);
  color: #94a3b8;
  padding-top: var(--space-16);
  padding-bottom: var(--space-8);
  border-top: 1px solid var(--brand-navy-border);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-10);
  margin-bottom: var(--space-12);
}

@media (min-width: 768px) {
  .footer-grid {
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
  }
}

.footer-brand img {
  height: 52px;
  width: auto;
  margin-bottom: var(--space-4);
  background: #ffffff;
  padding: 6px 12px;
  border-radius: var(--radius-md);
}

.footer-links a {
  display: block;
  color: #cbd5e1;
  font-size: 0.9rem;
  margin-bottom: 0.6rem;
}

.footer-links a:hover {
  color: var(--brand-gold);
  transform: translateX(4px);
}

/* --------------------------------------------------------------------------
   14. ANIMATIONS & REVEAL (RESILIENT VISIBILITY)
   -------------------------------------------------------------------------- */
.reveal {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 600ms ease, transform 600ms ease;
}

.reveal.revealed {
  opacity: 1;
  transform: translateY(0);
}

.reveal-stagger > * {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 500ms ease, transform 500ms ease;
}

.reveal-stagger.revealed > * {
  opacity: 1;
  transform: translateY(0);
}

/* Back to Top */
.back-to-top {
  position: fixed;
  bottom: 2rem;
  right: 2rem;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--brand-primary);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-xl);
  z-index: 990;
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
  border: none;
  cursor: pointer;
}

.back-to-top.is-visible {
  opacity: 1;
  visibility: visible;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .reveal, .reveal-stagger > * {
    opacity: 1 !important;
    transform: none !important;
  }
}

/* --------------------------------------------------------------------------
   ADDITIONAL COMPONENT STYLES FOR FORMS, MAP & CAROUSEL
   -------------------------------------------------------------------------- */
.form-field {
  margin-bottom: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  text-align: left;
}

.form-label {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--brand-navy);
}

.form-input, .form-select, .form-textarea {
  width: 100%;
  padding: 0.85rem 1.1rem;
  border: 1.5px solid var(--border-medium);
  border-radius: var(--radius-md);
  background-color: #ffffff;
  transition: all var(--transition-fast);
}

.form-input:focus, .form-select:focus, .form-textarea:focus {
  border-color: var(--brand-primary);
  box-shadow: 0 0 0 3px var(--brand-primary-alpha25);
  outline: none;
}

.form-input.is-invalid, .form-select.is-invalid, .form-textarea.is-invalid {
  border-color: var(--color-error);
}

.field-error {
  font-size: 0.8rem;
  color: var(--color-error);
  min-height: 1rem;
}

.field-help {
  font-size: 0.775rem;
  color: var(--text-muted);
}

/* Amount Presets Grid */
.amount-presets-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-3);
  margin-bottom: var(--space-4);
}

@media (min-width: 640px) {
  .amount-presets-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.amount-preset-btn {
  padding: var(--space-4) var(--space-2);
  border: 2px solid var(--border-medium);
  border-radius: var(--radius-lg);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--brand-navy);
  background-color: var(--bg-warm);
  transition: all var(--transition-fast);
  cursor: pointer;
}

.amount-preset-btn:hover {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary-light);
  color: var(--brand-primary);
}

.amount-preset-btn.is-selected {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary);
  color: #ffffff;
  box-shadow: 0 4px 12px rgba(255, 109, 18, 0.35);
}

.custom-amount-wrap {
  margin-top: var(--space-3);
  margin-bottom: var(--space-6);
}

.input-with-symbol {
  position: relative;
  display: flex;
  align-items: center;
}

.currency-symbol {
  position: absolute;
  left: 1.1rem;
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--text-muted);
}

.input-with-symbol input {
  padding-left: 2.5rem;
}

.selected-amount-banner {
  background: var(--brand-green-light);
  border: 1px solid rgba(27, 94, 32, 0.25);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-6);
}

.selected-amount-display {
  font-size: 1.45rem;
  font-weight: 800;
  color: var(--brand-green);
}

/* Payment Status Panels */
.donation-processing, .donation-success, .donation-error, .donation-pending {
  display: none;
  padding: var(--space-8);
  border-radius: var(--radius-xl);
  text-align: center;
}

.donation-processing.is-visible, 
.donation-success.is-visible, 
.donation-error.is-visible,
.donation-pending.is-visible {
  display: block;
}

.donation-success {
  background-color: var(--color-success-bg);
  border: 2px solid var(--color-success);
}

.donation-error {
  background-color: var(--color-error-bg);
  border: 2px solid var(--color-error);
}

.prototype-disclaimer {
  background: var(--bg-warm);
  border: 1px solid var(--brand-gold);
  border-radius: var(--radius-md);
  padding: var(--space-3) var(--space-4);
  font-size: 0.8rem;
  color: #92400e;
  margin-top: var(--space-6);
  line-height: 1.5;
}

/* Accordion Component */
.faq-accordion {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.faq-item {
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  overflow: hidden;
  background-color: #ffffff;
}

.faq-question {
  width: 100%;
  padding: var(--space-4) var(--space-5);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
  font-size: 1rem;
  color: var(--brand-navy);
  text-align: left;
  background: none;
  border: none;
  cursor: pointer;
}

.faq-question:hover {
  background-color: var(--bg-warm);
}

.faq-answer {
  padding: 0 var(--space-5) var(--space-4);
  font-size: 0.925rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Map Section */
.india-map-container {
  position: relative;
  background: var(--bg-warm);
  border-radius: var(--radius-2xl);
  border: 1px solid var(--border-light);
  padding: var(--space-6);
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400px;
}

.india-map-svg {
  width: 100%;
  max-width: 480px;
  height: auto;
}

.map-state {
  fill: #cbd5e1;
  stroke: #ffffff;
  stroke-width: 1.5;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.map-state.active-state {
  fill: var(--brand-primary);
}

.map-state.active-state:hover {
  fill: var(--brand-primary-deep);
  filter: drop-shadow(0 4px 8px rgba(255, 109, 18, 0.45));
}

.map-tooltip {
  position: absolute;
  background: var(--brand-navy);
  color: #ffffff;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  font-size: 0.8rem;
  box-shadow: var(--shadow-xl);
  pointer-events: none;
  opacity: 0;
  visibility: hidden;
  transition: opacity var(--transition-fast);
  max-width: 250px;
  z-index: 50;
}

.map-tooltip.is-visible {
  opacity: 1;
  visibility: visible;
}

.state-list-accessible {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.state-item {
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  border-left: 4px solid var(--brand-primary);
  border-top: 1px solid var(--border-light);
  border-right: 1px solid var(--border-light);
  border-bottom: 1px solid var(--border-light);
  transition: transform var(--transition-fast);
}

.state-item:hover {
  transform: translateX(4px);
}

.state-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--space-1);
}

.state-name {
  font-weight: 700;
  font-size: 1.05rem;
  color: var(--brand-navy);
}

.state-badge {
  font-size: 0.75rem;
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  padding: 0.15rem 0.6rem;
  border-radius: var(--radius-full);
  font-weight: 700;
}

/* Testimonials Carousel */
.testimonials-section {
  background-color: var(--bg-warm);
}

.testimonial-carousel {
  position: relative;
  max-width: 880px;
  margin: 0 auto;
  overflow: hidden;
}

.carousel-track {
  display: flex;
  transition: transform 500ms ease-in-out;
}

.carousel-slide {
  min-width: 100%;
  padding: var(--space-4);
}

.testimonial-card {
  background-color: #ffffff;
  border-radius: var(--radius-2xl);
  padding: var(--space-8);
  box-shadow: var(--shadow-lg);
  border: 1px solid rgba(255, 109, 18, 0.2);
}

@media (min-width: 768px) {
  .testimonial-card {
    padding: var(--space-12);
  }
}

.testimonial-quote-mark {
  font-family: var(--font-serif);
  font-size: 4.5rem;
  line-height: 1;
  color: var(--brand-primary);
  opacity: 0.25;
  margin-bottom: -1.25rem;
}

.testimonial-quote-text {
  font-family: var(--font-serif);
  font-size: clamp(1.2rem, 1.8vw + 0.4rem, 1.45rem);
  line-height: 1.65;
  color: var(--brand-navy);
  font-style: italic;
  margin-bottom: var(--space-6);
}

.testimonial-author-wrap {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.author-avatar {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--brand-primary), var(--brand-gold));
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 1.25rem;
}

.carousel-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--space-4);
  margin-top: var(--space-8);
}

.carousel-arrow {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background-color: #ffffff;
  border: 1px solid var(--border-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.25rem;
  color: var(--brand-navy);
  box-shadow: var(--shadow-sm);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.carousel-arrow:hover {
  background-color: var(--brand-primary);
  color: #ffffff;
  border-color: var(--brand-primary);
}

.carousel-dots {
  display: flex;
  gap: var(--space-2);
}

.carousel-dot {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background-color: var(--border-medium);
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.carousel-dot.is-active {
  background-color: var(--brand-primary);
  width: 28px;
  border-radius: var(--radius-full);
}

/* Subpage Components */
.page-hero {
  padding-top: calc(var(--header-height) + var(--space-8));
  padding-bottom: var(--space-12);
  background: linear-gradient(135deg, var(--bg-warm) 0%, #ffffff 100%);
  border-bottom: 1px solid var(--border-light);
}

.breadcrumbs {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  font-size: 0.825rem;
  color: var(--text-muted);
  margin-bottom: var(--space-3);
}

.breadcrumbs a {
  color: var(--brand-navy);
}

.breadcrumbs a:hover {
  color: var(--brand-primary);
}

.breadcrumbs .current {
  color: var(--brand-primary);
  font-weight: 600;
}

.page-title {
  margin-bottom: var(--space-3);
}

.page-lead {
  font-size: 1.15rem;
  color: var(--text-secondary);
  max-width: 820px;
  line-height: 1.7;
}

.team-grid, .programmes-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
}

@media (min-width: 768px) {
  .team-grid, .programmes-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

.profile-card, .programme-card {
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1px solid var(--border-light);
  padding: var(--space-8);
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  transition: all var(--transition-normal);
}

.profile-card:hover, .programme-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-xl);
  border-color: var(--brand-primary);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  margin-bottom: var(--space-3);
}

.profile-avatar-img {
  width: 74px;
  height: 74px;
  border-radius: 50%;
  object-fit: cover;
  border: 3px solid var(--brand-primary);
  box-shadow: var(--shadow-md);
}

.profile-role {
  color: var(--brand-primary);
  font-weight: 700;
  font-size: 0.9rem;
}

.doc-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.doc-card {
  background: #ffffff;
  border: 1px solid var(--border-light);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
  transition: all var(--transition-fast);
}

.doc-card:hover {
  border-color: var(--brand-primary);
  transform: translateX(4px);
  box-shadow: var(--shadow-md);
}

.doc-left {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.doc-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
}

/* Media Image Helpers */
.card-media-img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: var(--radius-lg);
  margin-bottom: var(--space-4);
  border: 1px solid var(--border-light);
}

.showcase-banner {
  width: 100%;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: var(--shadow-xl);
  border: 1px solid var(--border-light);
  margin: var(--space-8) 0;
}

.showcase-banner img {
  width: 100%;
  height: auto;
  max-height: 480px;
  object-fit: cover;
  display: block;
}

/* --------------------------------------------------------------------------
   15. GLOBAL SEARCH BAR & GLASSMORPHIC MODAL
   -------------------------------------------------------------------------- */
.search-btn-trigger {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.25);
  color: var(--brand-navy);
  padding: 6px 14px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.search-btn-trigger:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: var(--brand-primary);
  transform: translateY(-1px);
}

.search-btn-trigger .search-kbd {
  font-size: 0.7rem;
  background: rgba(6, 22, 58, 0.1);
  padding: 2px 6px;
  border-radius: 4px;
  font-family: monospace;
}

.search-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(6, 22, 58, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  z-index: 2000;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: calc(var(--header-height) + 40px) var(--space-4) var(--space-8);
  opacity: 0;
  visibility: hidden;
  transition: all var(--transition-normal);
}

.search-modal-backdrop.is-open {
  opacity: 1;
  visibility: visible;
}

.search-modal-dialog {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-2xl);
  box-shadow: 0 25px 60px rgba(6, 22, 58, 0.25);
  width: 100%;
  max-width: 640px;
  overflow: hidden;
  transform: scale(0.95);
  transition: transform var(--transition-normal);
}

.search-modal-backdrop.is-open .search-modal-dialog {
  transform: scale(1);
}

.search-input-header {
  display: flex;
  align-items: center;
  padding: var(--space-4) var(--space-6);
  border-bottom: 1px solid var(--border-light);
  gap: var(--space-3);
}

.search-input-header input {
  flex: 1;
  border: none;
  background: transparent;
  font-size: 1.15rem;
  font-family: var(--font-body);
  color: var(--brand-navy);
  outline: none;
}

.search-close-btn {
  background: none;
  border: none;
  font-size: 1.4rem;
  color: var(--text-muted);
  cursor: pointer;
  padding: 4px 8px;
}

.search-results-container {
  max-height: 380px;
  overflow-y: auto;
  padding: var(--space-4) var(--space-6);
}

.search-result-item {
  display: block;
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-md);
  text-decoration: none;
  color: var(--brand-navy);
  margin-bottom: var(--space-2);
  transition: all var(--transition-fast);
  background: rgba(255, 255, 255, 0.5);
}

.search-result-item:hover {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  transform: translateX(4px);
}

.search-result-title {
  font-weight: 700;
  font-size: 0.95rem;
}

.search-result-desc {
  font-size: 0.8rem;
  color: var(--text-secondary);
}

/* --------------------------------------------------------------------------
   16. CORE BELIEFS WITH IMAGES & GLASSMORPHISM
   -------------------------------------------------------------------------- */
.beliefs-image-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-6);
  margin-top: var(--space-10);
}

@media (min-width: 640px) {
  .beliefs-image-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .beliefs-image-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

.belief-img-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(6, 22, 58, 0.05);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.belief-img-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 20px 45px rgba(6, 22, 58, 0.12);
  border-color: var(--brand-primary);
}

.belief-img-wrap {
  width: 100%;
  height: 200px;
  overflow: hidden;
  position: relative;
}

.belief-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.belief-img-card:hover .belief-img-wrap img {
  transform: scale(1.06);
}

.belief-card-body {
  padding: var(--space-6);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.belief-num-badge {
  font-size: 0.8rem;
  font-weight: 800;
  color: var(--brand-primary);
  letter-spacing: 0.06em;
  margin-bottom: var(--space-2);
}

.belief-card-body h3 {
  font-size: 1.15rem;
  line-height: 1.35;
  color: var(--brand-navy);
  margin-bottom: var(--space-2);
}

.belief-card-body p {
  font-size: 0.875rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 0;
  flex: 1;
}

/* --------------------------------------------------------------------------
   17. THREE PILLARS WITH USER IMAGES & GLASSMORPHISM
   -------------------------------------------------------------------------- */
.pillars-image-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-8);
  margin-top: var(--space-12);
}

@media (min-width: 900px) {
  .pillars-image-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

.pillar-img-card {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(255, 255, 255, 0.95);
  border-radius: var(--radius-3xl);
  overflow: hidden;
  box-shadow: 0 14px 38px rgba(6, 22, 58, 0.07);
  transition: all var(--transition-normal);
  display: flex;
  flex-direction: column;
}

.pillar-img-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 24px 50px rgba(6, 22, 58, 0.14);
  border-color: var(--brand-primary);
}

.pillar-img-wrap {
  width: 100%;
  height: 240px;
  overflow: hidden;
  position: relative;
}

.pillar-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.pillar-img-card:hover .pillar-img-wrap img {
  transform: scale(1.05);
}

.pillar-tag-float {
  position: absolute;
  top: var(--space-4);
  left: var(--space-4);
  background: rgba(6, 22, 58, 0.75);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: #ffffff;
  padding: 4px 12px;
  border-radius: var(--radius-full);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.pillar-card-body {
  padding: var(--space-7);
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pillar-card-body h3 {
  font-size: 1.45rem;
  color: var(--brand-navy);
  margin-bottom: var(--space-2);
}

.pillar-card-body .pillar-subtitle {
  font-weight: 700;
  color: var(--brand-primary);
  font-size: 0.9rem;
  margin-bottom: var(--space-3);
}

.pillar-card-body p {
  font-size: 0.925rem;
  line-height: 1.65;
  color: var(--text-secondary);
  margin-bottom: var(--space-6);
  flex: 1;
}

/* --------------------------------------------------------------------------
   18. OUR REACH STATISTICS & FOCUS AREAS (EXACT ASPIRE-INDIA.ORG)
   -------------------------------------------------------------------------- */
.reach-strip-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-4);
}

@media (min-width: 640px) {
  .reach-strip-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1024px) {
  .reach-strip-grid {
    grid-template-columns: repeat(6, 1fr);
  }
}

.reach-stat-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.8);
  border-radius: var(--radius-xl);
  padding: var(--space-6) var(--space-4);
  text-align: center;
  box-shadow: 0 8px 24px rgba(6, 22, 58, 0.04);
}

.reach-stat-card .reach-num {
  font-size: 1.85rem;
  font-weight: 800;
  color: var(--brand-primary);
  line-height: 1;
  margin-bottom: 6px;
  font-family: var(--font-heading);
}

.reach-stat-card .reach-desc {
  font-size: 0.775rem;
  color: var(--text-secondary);
  font-weight: 600;
  line-height: 1.35;
}

.focus-pills-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  justify-content: center;
  margin-top: var(--space-8);
}

.focus-pill-tag {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(12px);
  border: 1px solid rgba(226, 232, 240, 0.9);
  padding: 8px 18px;
  border-radius: var(--radius-full);
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--brand-navy);
  box-shadow: 0 4px 14px rgba(6, 22, 58, 0.03);
  transition: all var(--transition-fast);
}

.focus-pill-tag:hover {
  background: var(--brand-primary-light);
  color: var(--brand-primary);
  border-color: var(--brand-primary);
  transform: translateY(-2px);
}


